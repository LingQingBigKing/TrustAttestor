    <string name="cloud_disclosure_meta">Data and purpose</string>
    <string name="cloud_disclosure_intro">Read for at least 3 seconds. After confirmation, L3 may send a cloud-attestation request to api.lingqing.ltd when its trigger conditions are met.</string>
